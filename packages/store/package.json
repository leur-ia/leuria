{
  "name": "@leuria/store",
  "version": "0.1.0",
  "description": "A vector index in the visitor's browser (IndexedDB), built with whatever embedding model the visitor has, rebuilt when it changes.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leur-ia/leuria.git",
    "directory": "packages/store"
  },
  "homepage": "https://leuria.dev",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@leuria/client": "workspace:^"
  },
  "devDependencies": {
    "@leuria/client": "workspace:*",
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
