{
  "name": "@leuria/web-embed",
  "version": "0.1.1",
  "description": "A small embedding model that runs in the page (Transformers.js), as a Leuria provider: search by meaning for visitors without their own model.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leur-ia/leuria.git",
    "directory": "packages/web-embed"
  },
  "homepage": "https://leuria.dev",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./cdn": { "types": "./dist/cdn.d.ts", "import": "./dist/cdn.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && cp src/worker.js dist/worker.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "peerDependencies": {
    "@leuria/client": "workspace:^"
  },
  "devDependencies": {
    "@leuria/client": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.9.0"
  }
}
